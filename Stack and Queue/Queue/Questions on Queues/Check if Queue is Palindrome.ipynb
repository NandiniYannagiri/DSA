   "source": [
    "from collections import deque\n",
    "# function declaration - Checking if Queue is Palindrome\n",
    "def is_palindrome(q):\n",
    "    temp = list(q)\n",
    "    return temp == temp[::-1]\n",
    "    \n",
    "# Driver code\n",
    "q = deque([1, 2, 3, 1])\n",
    "print(\"Queue:\", list(q))\n",
    "print(is_palindrome(q))"
   ]
  },
