   ],
   "source": [
    "# Peek Front Element Without Removing\n",
    "from collections import deque\n",
    "\n",
    "def peek(q):\n",
    "    if not q:\n",
    "        print(\"Queue is Empty\")\n",
    "    else:\n",
    "        print(\"Front element:\", q[0])\n",
    "\n",
    "# Driver\n",
    "q = deque([10, 20, 30])\n",
    "peek(q)\n",
    "print(\"Queue after peek:\", list(q))"
   ]
  },
